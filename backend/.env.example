# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL — use postgres user
DATABASE_URL=postgresql://postgres:123456789@localhost:5432/DB_MB

PGHOST=localhost
PGPORT=5432
PGDATABASE=DB_MB
PGUSER=postgres
PGPASSWORD=123456789

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin (used by npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@prod.com
ADMIN_PASSWORD=$2a$10$tH8tG8tH8tH8tH8tH8tH8uT8tH8tH8tH8tH8tH8tH8tH8tH8