# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL — either use DATABASE_URL, or the individual fields below
DATABASE_URL=postgresql://faza_user:faza_password@localhost:5432/faza_db

PGHOST=localhost
PGPORT=5432
PGDATABASE=faza_db
PGUSER=faza_user
PGPASSWORD=faza_password

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin (used by npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@faza.com
ADMIN_PASSWORD=admin123
